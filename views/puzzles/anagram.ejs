<%- include('../partials/header', {title: title, total: 'Puzzle 4', bodyClass: 'ana'}) %>
<style>
    .ana { 
    background: linear-gradient(95deg, var(--container), var(--bg));
    font-family: 'Times New Roman', Times, serif;
} body {
        display:flex
}
</style>
<p>The letters are scrambled. Figure out the word to proceed deeper:</p>
<p class="cipher"><%= mixed %></p>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<form method="POST" action="/puzzle/<%= slug %>">
  <input type="text" name="answer" autofocus>
  <button type="submit">Submit</button>
</form>
<%- include('../partials/footer') %>