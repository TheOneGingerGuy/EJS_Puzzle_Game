<%- include('partials/header') %>
<style> body {
        display: flex;
        background-color: linear-gradient(90deg, #00072dff, #0a2472ff);
        }
</style>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<form method="POST" action="/puzzle/<%= slug %>">
  <input type="hidden" name="v" value="<%= v %>">
  <input name="answer" autocomplete="off" required>
  <button>Submit</button>
</form>
<!-- Need method to keep an <a> link here and hidden till user completes riddle. -->
<%- include('partials/footer') %>