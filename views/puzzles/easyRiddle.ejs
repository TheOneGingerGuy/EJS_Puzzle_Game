<%- include('../partials/header', {title: title, total: 'Puzzle 2', bodyClass: 'eRiddle'}) %>
<style>
    .eRiddle {
    background: linear-gradient(90deg, var(--container), var(--panel));
    font-family: 'Courier New', Courier, monospace;
    } body {
        display: flex;
    }
</style>
<p><%= riddle %></p>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<form method="POST" action="/puzzle/<%= slug %>">
  <input type="hidden" name="v" value="<%= v %>">
  <input type="text" name="answer" autofocus>
  <button type="submit">Submit</button>
</form>
<%- include('../partials/footer') %>