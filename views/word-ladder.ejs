<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Word Ladder</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('partials/header.ejs') %>
    <% word = puzzles['word-ladder']["word"+Math.ceil(Math.random()*5)]
        console.log(word)
    %>
    <aside>
        <p>Change the starting word one letter at a time to get to the goal word! You are only allowed to change into real words as well.</p>
    </aside>
    <div class="container">Word-Ladder</div>
    <!-- WORD ONE -->
    <div class="letter selected"><%=  %></div>
    <div class="letter available"></div>
    <div class="letter available"></div>
    <div class="letter available"></div>
    <!-- WORD TWO -->
    <div class="letter dead"></div>
    <div class="letter dead"></div>
    <div class="letter dead"></div>
    <div class="letter dead"></div>
    <!-- WORD THREE -->
    <div class="letter dead"></div>
    <div class="letter dead"></div>
    <div class="letter dead"></div>
    <div class="letter dead"></div>
    <!-- WORD FOUR -->
    <div class="letter dead"></div>
    <div class="letter dead"></div>
    <div class="letter dead"></div>
    <div class="letter dead"></div>
    <!-- WORD FIVE -->
    <div class="letter dead"></div>
    <div class="letter dead"></div>
    <div class="letter dead"></div>
    <div class="letter dead"></div>
    <%- include('partials/footer.ejs') %>
</body>
</html>